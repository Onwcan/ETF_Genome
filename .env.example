# Copy to .env for local development. Do not put production secrets in source control.
# .env is ignored by the project ignore file. This example contains no real credentials.

ETF_GENOME_LOG_LEVEL=INFO
# Leave unset to use <project>/data during development, or %LOCALAPPDATA%\ETFGenome when frozen.
# ETF_GENOME_DATA_DIR=

# Required before any live SEC request. Include an application name and a contact email.
# ETF_GENOME_SEC_USER_AGENT=Example Research Name you@example.com

ETF_GENOME_SEC_TIMEOUT_SECONDS=20
ETF_GENOME_NETWORK_TIMEOUT_SECONDS=20
ETF_GENOME_SEC_MAX_RETRIES=3
ETF_GENOME_SEC_BACKOFF_SECONDS=0.5
ETF_GENOME_SEC_BACKOFF_FACTOR=2
ETF_GENOME_SEC_MIN_INTERVAL_SECONDS=1
ETF_GENOME_SEC_REQUESTS_PER_SECOND=1
ETF_GENOME_SEC_UPDATE_INTERVAL_HOURS=12
ETF_GENOME_STALE_AFTER_HOURS=12
ETF_GENOME_SEC_MAX_FILINGS_PER_SYNC=2
ETF_GENOME_AUTO_UPDATE_ENABLED=true
ETF_GENOME_OFFLINE_MODE=false

# Optional later. Leave unset. Never put a real key in source code.
# ETF_GENOME_FRED_API_KEY=

# Optional daily-market-data providers; supply credentials only in your local environment.
# ETF_GENOME_TWELVE_DATA_API_KEY=
# ETF_GENOME_TIINGO_API_KEY=
# ETF_GENOME_MASSIVE_API_KEY=
# ETF_GENOME_ALPHA_VANTAGE_API_KEY=
ETF_GENOME_PREFERRED_MARKET_PROVIDER=twelvedata

# The explicit submissions helper stays off unless you enable it.
# Desktop/CLI sync runs when a real User-Agent is set and offline mode is off.
ETF_GENOME_FEATURE_FLAGS__LIVE_SEC_FETCH=false
ETF_GENOME_FEATURE_FLAGS__GENOME_XRAY=true
ETF_GENOME_FEATURE_FLAGS__MANDATE_DRIFT=true
